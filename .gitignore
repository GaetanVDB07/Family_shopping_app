# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
dist/
build/
server/public

# Environment variables - Keep all sensitive env files out of git
.env
.env.*
!.env.example
# Allow committing workflows while ignoring other GitHub configs by default
.github*
!.github/
!.github/workflows/
!.github/workflows/*.yml

# Database
*.db
*.sqlite

# IDE files
.vscode/
.idea/
.qodo/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# TypeScript cache
*.tsbuildinfo
vite.config.ts.*

# Optional npm cache directory
.npm

# Coverage directory
coverage/

# Temporary files
tmp/
temp/
*.tar.gz

# Debug and test scripts in root (keep organized scripts in scripts/ directory)
/check-*.mjs
/test-*.mjs
/clean-*.mjs
/cleanup-*.mjs
/quick-fix.mjs

# Backup files
*.backup
*.bak
*.old

# Setup scripts (environment-specific) in root
/setup-databases.sh
.vercel
