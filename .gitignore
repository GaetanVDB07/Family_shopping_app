# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
dist/
build/
server/public

# Environment variables - Keep all sensitive env files out of git
.env
.env.*
!.env.example
# Allow committing selected GitHub config while ignoring other GitHub files by default
.github/*
!.github/workflows/
!.github/workflows/**
!.github/ISSUE_TEMPLATE/
!.github/ISSUE_TEMPLATE/**
!.github/instructions/
!.github/instructions/**

# Database / Local services
*.db
*.sqlite
supabase/

# IDE files
.vscode/
.idea/
.qodo/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# TypeScript cache
*.tsbuildinfo
vite.config.ts.*

# Optional npm cache directory
.npm

# Coverage directory
coverage/

# Temporary files
tmp/
temp/
*.tar.gz
.worktrees/
.codex/
.codex-remote-attachments/
.agents/
.playwright-mcp/

# Debug and test scripts in root (keep organized scripts in scripts/ directory)
/check-*.mjs
/test-*.mjs
/clean-*.mjs
/cleanup-*.mjs
/quick-fix.mjs

# Local-only dev demo helpers (not part of the app)
scripts/ensure-dev-test-user.mjs
.env.test.local
.cron-secret.local

# Backup files
*.backup
*.bak
*.old

# Setup scripts (environment-specific) in root
/setup-databases.sh
.vercel
