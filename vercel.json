{
  "version": 2,
  "builds": [
    {
      "src":  "package.json",
      "use":  "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build",
        "distDir":     "dist/public"
      }
    },
    {
      "src": "dist/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/:match*", "destination": "/dist/index.js" },
    { "source": "/:match*",      "destination": "/index.html"  }
  ]
}
